{
	"name": "@openapi-to/config-tsup",
	"version": "3.2.2",
	"private": true,
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"require": "./dist/index.cjs",
			"default": "./dist/index.cjs"
		},
		"./package.json": "./package.json",
		"./*": "./*"
	},
	"main": "dist/index.cjs",
	"module": "dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"!/**/**.test.**",
		"!/**/__tests__/**"
	],
	"scripts": {
		"build": "pnpm exec tsup",
		"clean": "pnpm exec rimraf dist",
		"lint": "pnpm exec biome lint .",
		"lint:fix": "pnpm exec biome lint --write --unsafe .",
		"start": "pnpm exec tsup --watch",
		"typecheck": "pnpm exec tsc -p tsconfig.json --noEmit --emitDeclarationOnly false"
	},
	"dependencies": {
		"@microsoft/api-extractor": "catalog:",
		"esbuild-plugin-file-path-extensions": "catalog:"
	},
	"devDependencies": {
		"@openapi-to/config-ts": "workspace:*"
	},
	"engines": {
		"node": ">=22"
	}
}
