{
	"name": "@openapi-to/core",
	"version": "4.0.0-rc.3",
	"description": "Compiler and plugin runtime for deterministic OpenAPI code generation",
	"keywords": [
		"typescript",
		"plugins",
		"codegen"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/Vc-great/openapi-to.git",
		"directory": "packages/core"
	},
	"bugs": {
		"url": "https://github.com/Vc-great/openapi-to/issues"
	},
	"homepage": "https://github.com/Vc-great/openapi-to#readme",
	"license": "MIT",
	"author": "Vc-great",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs",
			"default": "./dist/index.cjs"
		},
		"./utils": {
			"types": "./dist/utils.d.ts",
			"import": "./dist/utils.js",
			"require": "./dist/utils.cjs",
			"default": "./dist/utils.cjs"
		},
		"./package.json": "./package.json",
		"./*": "./*"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"src",
		"dist",
		"*.d.ts",
		"*.d.cts",
		"schema.json",
		"!src/openapi/fixtures/**",
		"!dist/**/*.map",
		"!/**/**.test.**",
		"!/**/__tests__/**"
	],
	"scripts": {
		"build": "pnpm run clean && pnpm exec tsup",
		"clean": "pnpm exec rimraf ./dist",
		"lint": "pnpm exec biome lint .",
		"lint:fix": "pnpm exec biome lint --write --unsafe .",
		"start": "pnpm run clean && pnpm exec tsup --watch",
		"test": "pnpm exec vitest run --passWithNoTests",
		"typecheck": "pnpm exec tsc -p ./tsconfig.json --noEmit --emitDeclarationOnly false"
	},
	"dependencies": {
		"@types/json-schema": "catalog:",
		"axios": "catalog:",
		"bundle-require": "catalog:",
		"code-block-writer": "catalog:",
		"consola": "catalog:",
		"cosmiconfig": "catalog:",
		"directory-tree": "catalog:",
		"do-swagger2openapi": "catalog:",
		"esbuild-fix-imports-plugin": "catalog:",
		"eventemitter3": "catalog:",
		"esbuild": "catalog:",
		"execa": "catalog:",
		"find-up": "catalog:",
		"fs-extra": "catalog:",
		"is-chinese": "catalog:",
		"is-url": "catalog:",
		"js-yaml": "catalog:",
		"js-runtime": "catalog:",
		"json-schema": "catalog:",
		"lodash": "catalog:",
		"natural-orderby": "catalog:",
		"oas": "catalog:",
		"openapi-types": "catalog:",
		"picocolors": "catalog:",
		"pinyin-pro": "catalog:",
		"seedrandom": "catalog:",
		"semver": "catalog:",
		"tinyrainbow": "catalog:",
		"ts-morph": "catalog:"
	},
	"devDependencies": {
		"@openapi-to/config-ts": "workspace:*",
		"@openapi-to/config-tsup": "workspace:*",
		"@types/fs-extra": "catalog:",
		"@types/js-yaml": "catalog:",
		"@types/is-url": "catalog:",
		"@types/lodash": "catalog:",
		"@types/seedrandom": "catalog:",
		"@types/semver": "catalog:",
		"ora": "catalog:"
	},
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	}
}
