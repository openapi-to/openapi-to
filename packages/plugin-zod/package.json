{
	"name": "@openapi-to/plugin-zod",
	"version": "4.0.0-rc.4",
	"sideEffects": false,
	"type": "module",
	"description": "Generate Zod schemas from OpenAPI documents",
	"repository": {
		"type": "git",
		"url": "https://github.com/Vc-great/openapi-to.git",
		"directory": "packages/plugin-zod"
	},
	"bugs": {
		"url": "https://github.com/Vc-great/openapi-to/issues"
	},
	"homepage": "https://github.com/Vc-great/openapi-to#readme",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./package.json": "./package.json",
		"./*": "./*"
	},
	"main": "dist/index.cjs",
	"module": "dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"!dist/**/*.map",
		"!/**/**.test.**",
		"!/**/__tests__/**"
	],
	"scripts": {
		"build": "pnpm exec tsup",
		"clean": "pnpm exec rimraf ./dist",
		"lint": "pnpm exec biome lint .",
		"lint:fix": "pnpm exec biome lint --write --unsafe .",
		"start": "pnpm exec tsup --watch",
		"test": "pnpm exec vitest run --passWithNoTests",
		"typecheck": "pnpm exec tsc -p ./tsconfig.json --noEmit --emitDeclarationOnly false"
	},
	"devDependencies": {
		"@openapi-to/config-ts": "workspace:*",
		"@openapi-to/config-tsup": "workspace:*",
		"@types/lodash": "^4.17.9",
		"zod": "^4.4.3"
	},
	"dependencies": {
		"@openapi-to/core": "workspace:*",
		"lodash": "^4.17.21",
		"oas": "^38.2.0",
		"ts-morph": "^23.0.0"
	},
	"peerDependencies": {
		"zod": "^4.0.0"
	},
	"engines": {
		"node": ">=22"
	},
	"keywords": [
		"openapi",
		"typescript",
		"codegen",
		"zod"
	],
	"author": "Vc-great",
	"license": "MIT",
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	}
}
