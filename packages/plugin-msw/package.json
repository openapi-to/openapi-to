{
	"name": "@openapi-to/plugin-msw",
	"version": "4.0.0-rc.4",
	"sideEffects": false,
	"type": "module",
	"description": "Generate Mock Service Worker handlers from OpenAPI operations",
	"repository": {
		"type": "git",
		"url": "https://github.com/Vc-great/openapi-to.git",
		"directory": "packages/plugin-msw"
	},
	"bugs": {
		"url": "https://github.com/Vc-great/openapi-to/issues"
	},
	"homepage": "https://github.com/Vc-great/openapi-to#readme",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./package.json": "./package.json",
		"./*": "./*"
	},
	"main": "dist/index.cjs",
	"module": "dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"!dist/**/*.map",
		"!/**/**.test.**",
		"!/**/__tests__/**"
	],
	"scripts": {
		"build": "pnpm exec tsup",
		"clean": "pnpm exec rimraf ./dist",
		"lint": "pnpm exec biome lint .",
		"lint:fix": "pnpm exec biome lint --write --unsafe .",
		"start": "pnpm exec tsup --watch",
		"test": "pnpm exec vitest run --passWithNoTests",
		"typecheck": "pnpm exec tsc -p ./tsconfig.json --noEmit --emitDeclarationOnly false"
	},
	"devDependencies": {
		"@openapi-to/config-ts": "workspace:*",
		"@openapi-to/config-tsup": "workspace:*",
		"@openapi-to/plugin-zod": "workspace:*",
		"@openapi-to/plugin-ts-type": "workspace:*",
		"utility-types": "^3.11.0"
	},
	"keywords": [
		"openapi",
		"typescript",
		"codegen",
		"msw"
	],
	"author": "Vc-great",
	"license": "MIT",
	"dependencies": {
		"@openapi-to/core": "workspace:*",
		"oas": "^38.2.0",
		"type-fest": "^4.40.0",
		"ts-morph": "^23.0.0"
	},
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	}
}
