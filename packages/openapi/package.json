{
	"name": "openapi-to",
	"version": "4.0.0-rc.4",
	"description": "OpenAPI compiler, CLI, and official TypeScript code-generation plugins",
	"keywords": [
		"openapi",
		"generate",
		"typescript",
		"plugins",
		"codegen",
		"cli",
		"zod",
		"msw",
		"swr",
		"vue-query"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/Vc-great/openapi-to.git",
		"directory": "packages/openapi"
	},
	"bugs": {
		"url": "https://github.com/Vc-great/openapi-to/issues"
	},
	"homepage": "https://github.com/Vc-great/openapi-to#readme",
	"license": "MIT",
	"author": "Vc-great",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./utils": {
			"types": "./dist/utils.d.ts",
			"import": "./dist/utils.js",
			"require": "./dist/utils.cjs"
		}
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"openapi": "bin/openapi.js",
		"openapi-to": "bin/openapi.js",
		"openapi-to-mcp": "bin/openapi-to-mcp.js"
	},
	"files": [
		"dist",
		"bin",
		"!dist/**/*.map",
		"!/**/**.test.**",
		"!/**/__tests__/**"
	],
	"scripts": {
		"build": "pnpm run clean && pnpm exec tsup",
		"clean": "pnpm exec rimraf ./dist",
		"lint": "pnpm exec biome lint .",
		"lint:fix": "pnpm exec biome lint --write --unsafe .",
		"start": "pnpm run clean && pnpm exec tsup --watch",
		"test": "pnpm exec vitest run --passWithNoTests",
		"typecheck": "pnpm exec tsc -p ./tsconfig.json --noEmit --emitDeclarationOnly false"
	},
	"dependencies": {
		"@openapi-to/cli": "workspace:*",
		"@openapi-to/core": "workspace:*",
		"@openapi-to/mcp": "workspace:*",
		"@openapi-to/plugin-swr": "workspace:*",
		"@openapi-to/plugin-msw": "workspace:*",
		"@openapi-to/plugin-vue-query": "workspace:*",
		"@openapi-to/plugin-ts-request": "workspace:*",
		"@openapi-to/plugin-ts-type": "workspace:*",
		"@openapi-to/plugin-zod": "workspace:*",
		"@types/update-notifier": "^6.0.8",
		"semver": "^7.8.5",
		"update-notifier": "^7.3.1"
	},
	"engines": {
		"node": ">=22",
		"pnpm": ">=10.7.1"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"devDependencies": {
		"@openapi-to/config-tsup": "workspace:*"
	}
}
