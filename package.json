{
	"name": "@openapi-to/root",
	"private": true,
	"type": "module",
	"workspaces": {
		"packages": [
			"packages/*",
			"e2e/*"
		]
	},
	"scripts": {
		"build": "pnpm exec turbo run build --filter=./packages/*",
		"clean": "pnpm exec turbo run clean",
		"format": "pnpm exec biome format --write .",
		"install:csb": "corepack enable && pnpm install --frozen-lockfile",
		"lint": "pnpm exec biome lint ./packages",
		"lint:changed": "node scripts/lint-changed.mjs",
		"lint:ci": "node scripts/lint-ci.mjs",
		"lint:fix": "pnpm exec biome lint --write --unsafe ./packages",
		"lint:turbo": "pnpm exec turbo run lint",
		"start": "pnpm exec turbo run start --filter=./packages/*",
		"test": "pnpm exec vitest run --config ./configs/vitest.config.ts --coverage",
		"test:vitest": "pnpm exec vitest run --config ./configs/vitest.config.ts",
		"verify:precommit": "pnpm run build && pnpm run test:vitest",
		"test:a1-contracts": "node scripts/run-a1-contracts.mjs",
		"test:e2e:common": "node e2e/run-cli-e2e.mjs common",
		"test:e2e:module": "node e2e/run-cli-e2e.mjs module",
		"test:e2e:remote": "node e2e/run-remote-e2e.mjs",
		"test:consumer:codegen": "node scripts/consumer-codegen-smoke.mjs",
		"test:consumer:codegen:review": "pnpm test:consumer:codegen -- --export-review-dir .ci-artifacts/consumer-codegen-review/current",
		"test:phase2-regressions": "node scripts/phase2-regression-smoke.mjs",
		"test:phase2-regressions:packed": "node scripts/phase2-packed-smoke.mjs",
		"test:release-scripts": "node --test scripts/*.node-test.mjs scripts/release/*.node-test.mjs",
		"test:mcp": "pnpm --filter @openapi-to/mcp run test",
		"test:mcp:unit": "pnpm --filter @openapi-to/mcp run test:unit",
		"test:mcp:integration": "pnpm --filter @openapi-to/mcp run test:integration",
		"test:mcp:smoke": "pnpm --filter @openapi-to/mcp run test:smoke",
		"test:mcp:stdio": "pnpm --filter @openapi-to/mcp run test:stdio",
		"test:mcp:write": "pnpm --filter @openapi-to/mcp run test:write",
		"test:mcp:recovery": "pnpm --filter @openapi-to/mcp run test:recovery",
		"test:mcp:performance": "pnpm --filter @openapi-to/mcp run test:performance",
		"test:mcp:e2e": "pnpm --filter @openapi-to/mcp run test:e2e",
		"test:mcp:all": "pnpm --filter @openapi-to/mcp run test:all",
		"mcp:check": "pnpm --silent --filter @openapi-to/mcp run doctor",
		"mcp:inspect": "pnpm --filter @openapi-to/mcp run inspect",
		"test:watch": "pnpm exec vitest --config ./configs/vitest.config.ts",
		"typecheck": "pnpm exec turbo run typecheck --continue --filter='./packages/*'",
		"//changeset:beta:alpha": "pnpm exec changeset pre enter alpha",
		"//changeset:beta:enter": "pnpm exec changeset pre enter beta",
		"//changeset:beta:rc": "pnpm exec changeset pre enter rc",
		"//changeset:beta:exit": "pnpm exec changeset pre exit",
		"changeset": "pnpm exec changeset",
		"verify:changeset-state": "node scripts/verify-changeset-state.mjs",
		"verify:changeset-state:development": "node scripts/verify-changeset-state.mjs --allow-pending",
		"verify:dependency-catalogs": "node scripts/verify-dependency-catalogs.mjs",
		"verify:repository-contract": "node scripts/repository-contract.mjs && node scripts/verify-dependency-catalogs.mjs",
		"verify:package-surface": "node scripts/release/verify-package-surface.mjs",
		"release:smoke": "node scripts/release/pack-install-smoke.mjs",
		"release:check:quality": "pnpm build && pnpm typecheck && pnpm test:vitest && pnpm lint:ci && pnpm test:release-scripts && pnpm verify:repository-contract && pnpm verify:package-surface",
		"release:check:prepack": "pnpm release:check:quality && pnpm verify:changeset-state",
		"release:check": "pnpm release:check:quality && pnpm release:smoke && pnpm verify:changeset-state",
		"version": "pnpm exec changeset version",
		"version:canary": "pnpm exec changeset version --snapshot canary",
		"prepare": "pnpm exec husky"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@changesets/changelog-github": "catalog:",
		"@changesets/cli": "catalog:",
		"@changesets/parse": "catalog:",
		"@commitlint/cli": "catalog:",
		"@commitlint/config-conventional": "catalog:",
		"@openapi-to/config-ts": "workspace:*",
		"@types/lodash-es": "catalog:",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"@vitest/ui": "catalog:",
		"bun-types": "catalog:",
		"husky": "catalog:",
		"js-yaml": "catalog:",
		"lodash-es": "catalog:",
		"remeda": "catalog:",
		"rimraf": "catalog:",
		"semver": "catalog:",
		"tar": "catalog:",
		"ts-node": "catalog:",
		"tsdown": "catalog:",
		"turbo": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vite-tsconfig-paths": "catalog:",
		"vitest": "catalog:",
		"ypkgfiles": "catalog:"
	},
	"packageManager": "pnpm@10.14.0",
	"engines": {
		"node": ">=22.12.0",
		"pnpm": ">=10.7.1"
	},
	"pnpm": {
		"patchedDependencies": {}
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"dependencies": {
		"@types/json-schema": "catalog:",
		"openapi-types": "catalog:",
		"type-fest": "catalog:"
	}
}
