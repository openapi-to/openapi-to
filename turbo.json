{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": [
		".agents/skills/openapi-to-generate/**",
		".agents/skills/openapi-to-setup/**",
		"docs/capability-matrix.md",
		"scripts/build-consumer-skill-assets.mjs"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"clean": {
			"dependsOn": ["^clean"],
			"outputs": [],
			"cache": false,
			"outputLogs": "new-only"
		},
		"start": {
			"dependsOn": ["^start"],
			"outputs": ["dist/**"],
			"cache": false,
			"persistent": true
		},
		"test": {
			"dependsOn": [],
			"outputs": ["coverage/**"],
			"cache": false
		},
		"lint": {
			"outputs": [],
			"cache": false
		},
		"typecheck": {
			"dependsOn": [],
			"outputs": [],
			"cache": false
		}
	}
}
