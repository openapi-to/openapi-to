{
	"openapi": "3.0.3",
	"info": { "title": "Header and cookie parameters", "version": "1.0.0" },
	"paths": {
		"/optional-header": {
			"get": {
				"tags": ["contracts"],
				"operationId": "optionalHeader",
				"parameters": [
					{
						"name": "X-Request-Id",
						"in": "header",
						"schema": { "type": "string" }
					}
				],
				"responses": { "204": { "description": "No content" } }
			}
		},
		"/required-header": {
			"get": {
				"tags": ["contracts"],
				"operationId": "requiredHeader",
				"parameters": [
					{
						"name": "X-Request-Id",
						"in": "header",
						"required": true,
						"schema": { "type": "string" }
					}
				],
				"responses": { "204": { "description": "No content" } }
			}
		},
		"/optional-cookie": {
			"get": {
				"tags": ["contracts"],
				"operationId": "optionalCookie",
				"parameters": [
					{ "name": "session", "in": "cookie", "schema": { "type": "string" } }
				],
				"responses": { "204": { "description": "No content" } }
			}
		},
		"/required-cookie": {
			"get": {
				"tags": ["contracts"],
				"operationId": "requiredCookie",
				"parameters": [
					{
						"name": "session",
						"in": "cookie",
						"required": true,
						"schema": { "type": "string" }
					}
				],
				"responses": { "204": { "description": "No content" } }
			}
		},
		"/combined": {
			"get": {
				"tags": ["contracts"],
				"operationId": "combinedHeaderCookie",
				"parameters": [
					{
						"name": "X-Trace",
						"in": "header",
						"required": true,
						"schema": { "type": "string" }
					},
					{
						"name": "tenant",
						"in": "cookie",
						"required": true,
						"schema": { "type": "string" }
					}
				],
				"responses": { "204": { "description": "No content" } }
			}
		},
		"/parameters/{id}": {
			"get": {
				"tags": ["contracts"],
				"operationId": "parameterMatrix",
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"required": true,
						"schema": { "type": "string" }
					},
					{
						"name": "X-Optional",
						"in": "header",
						"schema": { "type": "string" }
					},
					{
						"name": "X-Required",
						"in": "header",
						"required": true,
						"schema": { "type": "string" }
					},
					{ "$ref": "#/components/parameters/OptionalHeader" },
					{ "$ref": "#/components/parameters/RequiredHeader" },
					{
						"name": "optionalCookie",
						"in": "cookie",
						"schema": { "type": "string" }
					},
					{
						"name": "requiredCookie",
						"in": "cookie",
						"required": true,
						"schema": { "type": "string" }
					},
					{ "$ref": "#/components/parameters/SchemaHeader" },
					{ "$ref": "#/components/parameters/SchemaCookie" }
				],
				"responses": {
					"204": { "description": "No content" }
				}
			}
		}
	},
	"components": {
		"schemas": {
			"Token": {
				"type": "object",
				"required": ["value"],
				"properties": { "value": { "type": "string", "minLength": 1 } }
			}
		},
		"parameters": {
			"OptionalHeader": {
				"name": "X-Component-Optional",
				"in": "header",
				"schema": { "type": "string" }
			},
			"RequiredHeader": {
				"name": "X-Component-Required",
				"in": "header",
				"required": true,
				"schema": { "type": "string" }
			},
			"SchemaHeader": {
				"name": "X-Token",
				"in": "header",
				"required": true,
				"schema": { "$ref": "#/components/schemas/Token" }
			},
			"SchemaCookie": {
				"name": "token",
				"in": "cookie",
				"required": true,
				"content": {
					"application/json": {
						"schema": { "$ref": "#/components/schemas/Token" }
					}
				}
			}
		}
	}
}
