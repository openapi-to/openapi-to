{
	"openapi": "3.1.0",
	"info": {
		"title": "Recursive component schemas",
		"version": "1.0.0"
	},
	"paths": {},
	"components": {
		"schemas": {
			"External": {
				"type": "object",
				"required": ["id"],
				"properties": { "id": { "type": "string" } }
			},
			"GhostNode": {
				"type": "object",
				"required": ["ghost"],
				"properties": { "next": { "$ref": "#/components/schemas/GhostNode" } }
			},
			"Node": {
				"type": "object",
				"required": ["value"],
				"properties": {
					"value": { "type": "string" },
					"child": { "$ref": "#/components/schemas/Node" },
					"children": {
						"type": "array",
						"items": { "$ref": "#/components/schemas/Node" }
					},
					"lookup": {
						"type": "object",
						"additionalProperties": {
							"$ref": "#/components/schemas/Node"
						}
					},
					"external": { "$ref": "#/components/schemas/External" }
				}
			}
		}
	}
}
